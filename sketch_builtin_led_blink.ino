void setup() {
  // Установить встроенный светодиод (L - на плате) в режим выхода 
  pinMode(LED_BUILTIN, OUTPUT);
}

void loop() {
  // Включить встроенный светодиод, 1 (HIGH) отправить напряжение на пин
  digitalWrite(LED_BUILTIN, 1);
  // Подождать секунду конвертируем в милисекунды
  delay(1000);
  // Выключить светодиод, 0 (LOW) убрать напряжение с пина
  digitalWrite(LED_BUILTIN, 0);
  // Подождать пол-секунды и конвертируем в милисекунды
  delay(500);
}
